{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cnbuycha",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public-app",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cnbuycha",
      "database_id": "46454e2d-4039-4a34-81b6-d9e2fa877287",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "MEDIA_A",
      "service": "cnbuycha-media-a"
    },
    {
      "binding": "MEDIA_B",
      "service": "cnbuycha-media-b"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "admin"
  }
}
